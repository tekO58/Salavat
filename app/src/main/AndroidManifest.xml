<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Tespih sayacinin dokunus titresimi. Normal izin; kullaniciya sorulmaz. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Salavat">

        <activity
            android:name=".HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".SectionActivity" android:exported="false" />
        <activity android:name=".EntryActivity" android:exported="false" />
        <!-- adjustResize: klavye acilinca Kaydet dugmesi ustte kalsin. -->
        <activity
            android:name=".AddEntryActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".TasbihCounterActivity" android:exported="false" />
    </application>
</manifest>
